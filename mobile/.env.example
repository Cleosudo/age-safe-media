# ---------------------------------------------------------------------------
# Copy to mobile/.env and restart the dev server (expo start -c).
# Only EXPO_PUBLIC_* variables are exposed to the app bundle — never put
# service-account keys or admin secrets here.
# ---------------------------------------------------------------------------

# Explicit API base URL. Leave blank to auto-detect:
#  - web / iOS simulator  -> http://localhost:8010
#  - Expo Go on a phone   -> http://<your-computer-LAN-IP>:8010
# Set this when the backend runs on another machine or on a deployed host.
EXPO_PUBLIC_API_URL=

# Port used when the URL is auto-detected (default 8010).
EXPO_PUBLIC_API_PORT=8010

# ------------------------------- Firebase ---------------------------------
# Leave all four blank to run in local demo mode (no Firebase project needed).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
