# ---------------------------------------------------------------------------
# Copy to mock-api/.env and edit.  Never commit real secrets.
# Reminder: this folder is the development mock, not the project deliverable.
# ---------------------------------------------------------------------------

# development | staging | production
ENVIRONMENT=development
APP_NAME=Age-Safe Media Recommender

# Development auth lets the mobile app call the API without a Firebase project
# using bearer tokens of the form "dev:<email>".  MUST be false in production.
DEV_AUTH=true

# Admin Web Portal credentials (change these!)
ADMIN_EMAIL=admin@agesafe.sg
ADMIN_PASSWORD=Admin123!
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite location (relative paths resolve from mock-api/)
DATABASE_PATH=./data/agesafe.db
SEED_DEMO_DATA=true

# Firebase (production).  Path to a service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/serviceAccountKey.json
# FIREBASE_PROJECT_ID=your-project-id

# Where the Admin Web Portal templates + static files live.  The portal is a
# frontend asset (admin-portal/); this stub only serves it.
# ADMIN_PORTAL_DIR=../admin-portal

# Browser origins allowed to call the API (Expo web preview, etc.)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
